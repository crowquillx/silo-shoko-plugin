{
  "plugin_id": "silo.shokoanime",
  "version": "0.2.3",
  "checksum": "__CHECKSUM__",
  "silo_api_version": "v1",
  "supported_platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    },
    {
      "os": "linux",
      "arch": "arm64"
    },
    {
      "os": "darwin",
      "arch": "arm64"
    }
  ],
  "presentation": {
    "display_name": "ShokoAnime VFS",
    "summary": "Builds a Shoko-backed virtual filesystem for Silo libraries.",
    "description_markdown": "Works with both stable (5.x) and daily (6.x) Shoko Server. Reads Shoko Server API v3, reconciles deterministic plugin-owned leaf symlinks, and publishes successful VFS changes for targeted Silo scans. It deliberately does not expose remote streams or modify Shoko data.",
    "setup_markdown": "Configure a Shoko Server URL, API key, a Silo-visible output root, and managed-folder path mappings, then use the connection test: it checks the URL, the API key, and every mapped folder. The plugin and Silo must share the same filesystem namespace. Run the Reconcile Shoko VFS task to build the library: a crawl that outlasts the task keeps running in the background, and the task output reports its progress. Enable the Shoko VFS autoscan source so Silo scans changed paths automatically.",
    "homepage_url": "https://github.com/crowquillx/silo-shoko-plugin",
    "source_url": "https://github.com/crowquillx/silo-shoko-plugin",
    "support_url": "https://github.com/crowquillx/silo-shoko-plugin/issues",
    "changelog_url": "https://github.com/crowquillx/silo-shoko-plugin/releases",
    "publisher_name": "Renkei",
    "publisher_url": "https://github.com/crowquillx",
    "license_spdx": "MIT"
  },
  "capabilities": [
    {
      "type": "metadata_provider.v1",
      "id": "shoko",
      "display_name": "Shoko",
      "description": "Exact Shoko series and episode metadata for VFS paths.",
      "metadata": {
        "default_priority": {
          "movie": 1,
          "series": 1,
          "season": 1,
          "episode": 1
        },
        "rating_sources": [
          {
            "id": "anidb",
            "name": "AniDB",
            "scale": 10
          }
        ]
      }
    },
    {
      "type": "image_resolver.v1",
      "id": "shoko",
      "display_name": "Shoko Images",
      "description": "Resolves opaque shoko://image/ paths to Shoko image URLs.",
      "metadata": {
        "schemes": [
          "shoko"
        ],
        "priority": 100
      }
    },
    {
      "type": "scheduled_task.v1",
      "id": "reconcile",
      "display_name": "Reconcile Shoko VFS",
      "description": "Plans and reconciles plugin-owned Shoko VFS links."
    },
    {
      "type": "scan_source.v1",
      "id": "shoko",
      "display_name": "Shoko VFS changes",
      "description": "Reports successfully reconciled VFS paths so Silo can scan them automatically."
    }
  ],
  "global_config_schema": [
    {
      "key": "connection",
      "title": "ShokoAnime connection",
      "description": "Shoko connection and VFS path policy. The API key is encrypted by Silo.",
      "json_schema": "{\"type\":\"object\",\"properties\":{\"base_url\":{\"type\":\"string\",\"format\":\"uri\",\"minLength\":1},\"image_mode\":{\"type\":\"string\",\"enum\":[\"direct\",\"public_url\",\"s3\"]},\"image_base_url\":{\"type\":\"string\"},\"s3_endpoint\":{\"type\":\"string\"},\"s3_region\":{\"type\":\"string\"},\"s3_bucket\":{\"type\":\"string\"},\"s3_prefix\":{\"type\":\"string\"},\"s3_access_key_id\":{\"type\":\"string\"},\"s3_secret_access_key\":{\"type\":\"string\"},\"api_key\":{\"type\":\"string\",\"minLength\":1},\"vfs_root\":{\"type\":\"string\",\"minLength\":1},\"managed_folder_map\":{\"type\":\"string\",\"minLength\":2}},\"required\":[\"base_url\",\"api_key\",\"vfs_root\",\"managed_folder_map\"],\"additionalProperties\":false}",
      "required": true,
      "admin_form": {
        "fields": [
          {
            "key": "base_url",
            "label": "Shoko Server URL",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "required": true,
            "placeholder": "http://shoko:8111"
          },
          {
            "key": "image_mode",
            "label": "Artwork source",
            "description": "Where Silo downloads Shoko artwork from. Silo only caches artwork from public addresses, so if Shoko is on a private network, use a public image URL or an S3 bucket.",
            "control": "ADMIN_FORM_CONTROL_SELECT",
            "default_value": "direct",
            "options": [
              {
                "value": "direct",
                "label": "Shoko Server URL",
                "description": "Use the Shoko Server URL above. Silo can cache it only if that URL is public."
              },
              {
                "value": "public_url",
                "label": "Public image URL",
                "description": "A public URL that serves Shoko's /api/v3/Image/ path."
              },
              {
                "value": "s3",
                "label": "Copy to S3",
                "description": "Copy each image into an S3 bucket with a public endpoint, and give Silo a signed link to the copy."
              }
            ]
          },
          {
            "key": "image_base_url",
            "label": "Public image URL",
            "description": "Serves Shoko's /api/v3/Image/<id> path, for example through a reverse proxy that allows only that path.",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "placeholder": "https://shoko-images.example.com",
            "show_when": [
              {
                "field": "image_mode",
                "equals": [
                  "public_url"
                ]
              }
            ]
          },
          {
            "key": "s3_endpoint",
            "label": "S3 endpoint",
            "description": "Must be a public address, since Silo downloads the signed links from it.",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "placeholder": "https://s3.example.com",
            "show_when": [
              {
                "field": "image_mode",
                "equals": [
                  "s3"
                ]
              }
            ]
          },
          {
            "key": "s3_region",
            "label": "S3 region",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "placeholder": "us-east-1",
            "show_when": [
              {
                "field": "image_mode",
                "equals": [
                  "s3"
                ]
              }
            ]
          },
          {
            "key": "s3_bucket",
            "label": "S3 bucket",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "show_when": [
              {
                "field": "image_mode",
                "equals": [
                  "s3"
                ]
              }
            ]
          },
          {
            "key": "s3_prefix",
            "label": "S3 key prefix",
            "description": "Optional folder inside the bucket.",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "show_when": [
              {
                "field": "image_mode",
                "equals": [
                  "s3"
                ]
              }
            ]
          },
          {
            "key": "s3_access_key_id",
            "label": "S3 access key ID",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "show_when": [
              {
                "field": "image_mode",
                "equals": [
                  "s3"
                ]
              }
            ]
          },
          {
            "key": "s3_secret_access_key",
            "label": "S3 secret access key",
            "control": "ADMIN_FORM_CONTROL_PASSWORD",
            "secret": true,
            "show_when": [
              {
                "field": "image_mode",
                "equals": [
                  "s3"
                ]
              }
            ]
          },
          {
            "key": "api_key",
            "label": "API key",
            "control": "ADMIN_FORM_CONTROL_PASSWORD",
            "required": true,
            "secret": true
          },
          {
            "key": "vfs_root",
            "label": "VFS output root",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "required": true,
            "placeholder": "/srv/silo/shoko-vfs"
          },
          {
            "key": "managed_folder_map",
            "label": "Managed-folder path map (JSON)",
            "control": "ADMIN_FORM_CONTROL_TEXTAREA",
            "required": true,
            "multiline": true,
            "rows": 5,
            "placeholder": "{\"1\": \"/media/anime\"}"
          }
        ]
      }
    }
  ]
}
